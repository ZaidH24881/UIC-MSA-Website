// Generated by scripts/generate-admin-rules.mjs. Deploy before the new admin client.
rules_version = '2';
service cloud.firestore {
match /databases/{database}/documents {
 function board() { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email in ['msaatuic@gmail.com','zhaid3@uic.edu']; }
 function finance() { return board() && request.auth.token.get('msaRole','') in ['admin','treasurer']; }
 function permitted(kind) { return kind in ['donations','giving'] ? finance() : board(); }
 function valid_prayer(d) {
  return d.keys().hasAll(["title","location","directions","locationUrl","effectiveFrom","effectiveTo","time1","room1","time2","room2","time3","room3","time4","room4","dailyLocation","dailyHours","dailyDirections","accessibility","dailyUrl","announcement"]) && d.keys().hasOnly(["title","location","directions","locationUrl","effectiveFrom","effectiveTo","time1","room1","time2","room2","time3","room3","time4","room4","dailyLocation","dailyHours","dailyDirections","accessibility","dailyUrl","announcement"])
  && d.title is string && d.title.size() <= 1000 && d.title.size() > 0
  && d.location is string && d.location.size() <= 1000 && d.location.size() > 0
  && d.directions is string && d.directions.size() <= 5000
  && d.locationUrl is string && d.locationUrl.size() <= 1000 && (d.locationUrl == '' || d.locationUrl.matches("https://[^/@ :]+([/?#][^ ]*)?"))
  && d.effectiveFrom is string && d.effectiveFrom.size() <= 1000 && d.effectiveFrom.size() > 0 && (d.effectiveFrom == '' || d.effectiveFrom.matches("[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])"))
  && d.effectiveTo is string && d.effectiveTo.size() <= 1000 && d.effectiveTo.size() > 0 && (d.effectiveTo == '' || d.effectiveTo.matches("[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])"))
  && d.time1 is string && d.time1.size() <= 1000 && d.time1.size() > 0 && (d.time1 == '' || d.time1.matches("([01][0-9]|2[0-3]):[0-5][0-9]"))
  && d.room1 is string && d.room1.size() <= 1000
  && d.time2 is string && d.time2.size() <= 1000 && (d.time2 == '' || d.time2.matches("([01][0-9]|2[0-3]):[0-5][0-9]"))
  && d.room2 is string && d.room2.size() <= 1000
  && d.time3 is string && d.time3.size() <= 1000 && (d.time3 == '' || d.time3.matches("([01][0-9]|2[0-3]):[0-5][0-9]"))
  && d.room3 is string && d.room3.size() <= 1000
  && d.time4 is string && d.time4.size() <= 1000 && (d.time4 == '' || d.time4.matches("([01][0-9]|2[0-3]):[0-5][0-9]"))
  && d.room4 is string && d.room4.size() <= 1000
  && d.dailyLocation is string && d.dailyLocation.size() <= 1000 && d.dailyLocation.size() > 0
  && d.dailyHours is string && d.dailyHours.size() <= 1000 && d.dailyHours.size() > 0
  && d.dailyDirections is string && d.dailyDirections.size() <= 5000 && d.dailyDirections.size() > 0
  && d.accessibility is string && d.accessibility.size() <= 5000
  && d.dailyUrl is string && d.dailyUrl.size() <= 1000 && (d.dailyUrl == '' || d.dailyUrl.matches("https://[^/@ :]+([/?#][^ ]*)?"))
  && d.announcement is string && d.announcement.size() <= 5000
  && d.effectiveTo >= d.effectiveFrom;
}
function valid_events(d) {
  return d.keys().hasAll(["title","description","start","end","location","audience","rsvpUrl","status","category","flyer","photo","photoAlt","recap"]) && d.keys().hasOnly(["title","description","start","end","location","audience","rsvpUrl","status","category","flyer","photo","photoAlt","recap"])
  && d.title is string && d.title.size() <= 1000 && d.title.size() > 0
  && d.description is string && d.description.size() <= 5000 && d.description.size() > 0
  && d.start is string && d.start.size() <= 1000 && d.start.size() > 0 && (d.start == '' || d.start.matches("[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]"))
  && d.end is string && d.end.size() <= 1000 && d.end.size() > 0 && (d.end == '' || d.end.matches("[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]"))
  && d.location is string && d.location.size() <= 1000 && d.location.size() > 0
  && d.audience is string && d.audience.size() <= 1000 && d.audience.size() > 0
  && d.rsvpUrl is string && d.rsvpUrl.size() <= 1000 && (d.rsvpUrl == '' || d.rsvpUrl.matches("https://[^/@ :]+([/?#][^ ]*)?"))
  && d.status is string && d.status.size() <= 1000 && d.status.size() > 0 && d.status in ["confirmed","cancelled","postponed"]
  && d.category is string && d.category.size() <= 1000 && d.category in ["","ramadan","community","learning","service"]
  && d.flyer is string && d.flyer.size() <= 900000 && (d.flyer == '' || d.flyer.matches("data:image/jpeg;base64,[A-Za-z0-9+/=]+"))
  && d.photo is string && d.photo.size() <= 1000 && (d.photo == '' || d.photo.matches("/assets/[A-Za-z0-9_./-]+"))
  && d.photoAlt is string && d.photoAlt.size() <= 1000
  && d.recap is string && d.recap.size() <= 5000
  && d.end > d.start;
}
function valid_khutbahs(d) {
  return d.keys().hasAll(["title","speaker","date","description","url","transcript","order"]) && d.keys().hasOnly(["title","speaker","date","description","url","transcript","order"])
  && d.title is string && d.title.size() <= 1000 && d.title.size() > 0
  && d.speaker is string && d.speaker.size() <= 1000 && d.speaker.size() > 0
  && d.date is string && d.date.size() <= 1000 && d.date.size() > 0 && (d.date == '' || d.date.matches("[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])"))
  && d.description is string && d.description.size() <= 5000 && d.description.size() > 0
  && d.url is string && d.url.size() <= 1000 && d.url.size() > 0 && (d.url == '' || d.url.matches("https://(www[.])?(youtube[.]com|youtu[.]be|vimeo[.]com|soundcloud[.]com)/[^ ]+"))
  && d.transcript is string && d.transcript.size() <= 1000 && (d.transcript == '' || d.transcript.matches("https://[^/@ :]+([/?#][^ ]*)?"))
  && d.order is int && d.order >= 0 && d.order <= 9999;
}
function valid_donations(d) {
  return d.keys().hasAll(["title","recipient","alternative","instruction","url","order"]) && d.keys().hasOnly(["title","recipient","alternative","instruction","url","order"])
  && d.title is string && d.title.size() <= 1000 && d.title.size() > 0
  && d.recipient is string && d.recipient.size() <= 1000 && d.recipient.size() > 0
  && d.alternative is string && d.alternative.size() <= 1000
  && d.instruction is string && d.instruction.size() <= 5000 && d.instruction.size() > 0
  && d.url is string && d.url.size() <= 1000 && (d.url == '' || d.url.matches("https://[^/@ :]+([/?#][^ ]*)?"))
  && d.order is int && d.order >= 0 && d.order <= 9999;
}
function valid_giving(d) {
  return d.keys().hasAll(["title","description","purpose"]) && d.keys().hasOnly(["title","description","purpose"])
  && d.title is string && d.title.size() <= 1000 && d.title.size() > 0
  && d.description is string && d.description.size() <= 5000 && d.description.size() > 0
  && d.purpose is string && d.purpose.size() <= 5000 && d.purpose.size() > 0;
}
 function validRecord(r,key) {
   return r.keys().hasOnly(['kind','id','data','revision','schemaVersion','archived','updatedAt','publishedAt','updatedBy'])
   && r.keys().hasAll(['kind','id','data','revision','schemaVersion','archived','updatedAt','publishedAt','updatedBy'])
   && r.kind in ["prayer","events","khutbahs","donations","giving"]
   && r.id is string && r.id.size() <= 100 && r.id.matches('[a-z0-9]+(-[a-z0-9]+)*')
   && key == r.kind + '--' + r.id
   && (r.kind != 'prayer' || r.id == 'current') && (r.kind != 'giving' || r.id == 'campaign')
   && r.schemaVersion == 1 && r.revision is int && r.revision >= 0 && r.archived is bool
   && r.updatedBy == request.auth.token.email && r.updatedAt is timestamp && r.updatedAt == request.time
   && (r.publishedAt == null || r.publishedAt is timestamp) && r.data is map
   && ((r.kind == 'prayer' && valid_prayer(r.data)) || (r.kind == 'events' && valid_events(r.data)) || (r.kind == 'khutbahs' && valid_khutbahs(r.data)) || (r.kind == 'donations' && valid_donations(r.data)) || (r.kind == 'giving' && valid_giving(r.data)));
 }
 function baseRevision(key) { return exists(/databases/$(database)/documents/cmsPublic/$(key)) ? get(/databases/$(database)/documents/cmsPublic/$(key)).data.revision : 0; }
 match /cmsPublic/{key} {
   allow read: if true;
   allow create, update: if permitted(request.resource.data.kind) && validRecord(request.resource.data,key)
     && request.resource.data.revision == baseRevision(key) + 1
     && request.resource.data.publishedAt == request.resource.data.updatedAt
     && getAfter(/databases/$(database)/documents/cmsHistory/$(key + '--' + string(request.resource.data.revision))).data == request.resource.data;
   allow delete: if false;
 }
 match /cmsDrafts/{key} {
   allow read: if board();
   allow create, update: if board() && validRecord(request.resource.data,key) && request.resource.data.revision == baseRevision(key);
   allow delete: if board() && permitted(resource.data.kind);
 }
 match /cmsHistory/{key} {
   allow read: if board();
   allow create: if permitted(request.resource.data.kind)
     && validRecord(request.resource.data,request.resource.data.kind + '--' + request.resource.data.id)
     && key == request.resource.data.kind + '--' + request.resource.data.id + '--' + string(request.resource.data.revision)
     && getAfter(/databases/$(database)/documents/cmsPublic/$(request.resource.data.kind + '--' + request.resource.data.id)).data == request.resource.data;
   allow update, delete: if false;
 }
 // Existing documents stay readable; edits now live in cmsPublic and override by slug.
 match /events/{eventId} { allow read: if true; allow write: if false; }
 match /{document=**} { allow read, write: if false; }
}
}
