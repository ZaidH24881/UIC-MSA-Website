---
interface Props {
  hero?: boolean;
}
const { hero = false } = Astro.props;
const moons = Array.from({ length: hero ? 16 : 12 }, (_, i) => ({
  x: (i * 37 + 7) % 100,
  y: (i * 23 + 11) % 100,
  size: i % 3 === 0 ? 32 : 18,
  delay: -(i % 7),
}));
---

<div class:list={['celestial-sky', { 'celestial-sky--hero': hero }]} aria-hidden="true">
  <div class="sky-glow sky-glow--blue"></div>
  <div class="sky-glow sky-glow--gold"></div>
  <div class="sky-orbit sky-orbit--one"></div>
  <div class="sky-orbit sky-orbit--two"></div>
  <svg class="sky-phases" viewBox="0 0 240 80" fill="none">
    <circle cx="40" cy="40" r="22" stroke="currentColor" />
    <path d="M120 18 A22 22 0 1 0 120 62 A14 22 0 0 1 120 18Z" fill="currentColor" />
    <circle cx="200" cy="40" r="22" fill="currentColor" />
  </svg>
  {moons.map((moon, i) => (
    <span
      class:list={['sky-moon', { 'sky-moon--gold': i % 3 === 0 }]}
      style={`--x:${moon.x}%;--y:${moon.y}%;--size:${moon.size}px;--delay:${moon.delay}s;--duration:${8 + (i % 5)}s`}
    >
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M17 2A10 10 0 1 0 22 17A9 9 0 0 1 17 2Z" />
      </svg>
    </span>
  ))}
</div>
