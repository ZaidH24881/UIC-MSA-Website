---
import { resourceLinks } from '../data/site';
import Icon from './Icon.astro';
interface Props {
  featured?: boolean;
}
const { featured = false } = Astro.props;
---

<div class:list={['resource-grid', { 'resource-bento': featured }]}>
  {resourceLinks.map((item) => (
    <a class="resource-link" href={item.url} data-glow={featured ? '' : undefined}>
      <span class="resource-icon">
        <Icon name={item.icon} />
      </span>
      <div>
        <h3>{item.title}</h3>
        <p>{item.description}</p>
      </div>
      <Icon />
      {featured && <span class="glow-border" aria-hidden="true"></span>}
    </a>
  ))}
</div>
