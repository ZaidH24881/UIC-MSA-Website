---
import { resourceLinks } from '../data/site';
import Icon from './Icon.astro';
import ResourceArtwork from './ResourceArtwork.astro';
interface Props {
  featured?: boolean;
}
const { featured = false } = Astro.props;
---

<div class:list={['resource-grid', { 'resource-bento': featured }]}>
  {resourceLinks.map((item, index) => (
    <a
      class="resource-link"
      href={item.url}
      data-glow={featured ? '' : undefined}
      data-resource={featured ? index : undefined}
    >
      {featured && <ResourceArtwork index={index} />}
      {!featured && (
        <span class="resource-icon">
          <Icon name={item.icon} />
        </span>
      )}
      <div class="resource-copy">
        <h3>{item.title}</h3>
        <p>{item.description}</p>
      </div>
      <Icon />
      {featured && <span class="glow-border" aria-hidden="true"></span>}
    </a>
  ))}
</div>
