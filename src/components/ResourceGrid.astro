---
import { resourceLinks } from '../data/site';
import Icon from './Icon.astro';
---

<div class="resource-grid">
  {resourceLinks.map((item) => (
    <a class="resource-link" href={item.url}>
      <span class="resource-icon">
        <Icon name={item.icon} />
      </span>
      <div>
        <h3>{item.title}</h3>
        <p>{item.description}</p>
      </div>
      <Icon />
    </a>
  ))}
</div>
