---
import eventData from '../data/events.json';
import { currentEvents, dateLabel, shortDateLabel, timeLabel, type EventRecord } from '../lib/events';
import { site } from '../data/site';
import Icon from './Icon.astro';
interface Props {
  limit?: number;
  past?: boolean;
  category?: string;
  compact?: boolean;
}
const { limit, past = false, category, compact = false } = Astro.props;
const records = (eventData.events as EventRecord[])
  .filter((event) => !category || event.category === category)
  .filter((event) => !limit || event.status === 'confirmed');
const events = (
  past
    ? records
        .filter((e) => new Date(e.end) <= new Date())
        .sort((a, b) => +new Date(b.start) - +new Date(a.start))
    : currentEvents(records)
).slice(0, limit);
---

{past && events.length > 0 && <h2 class="past-events-heading">Past gatherings</h2>}
{events.length ? (
  compact ? (
    <ul class="event-agenda">
      {events.map((event) => (
        <li class="event-agenda-item">
          <span class="event-agenda-date">{shortDateLabel(event.start)}</span>
          <a class="event-agenda-title" href={`/events/${event.slug}/`}>
            {event.title}
          </a>
          <span class="event-agenda-meta">
            {timeLabel(event.start)} · {event.location || 'Location to be confirmed'}
          </span>
          {event.status !== 'confirmed' && <span class="status-label">{event.status}</span>}
        </li>
      ))}
    </ul>
  ) : (
    <div class:list={['event-grid', { 'single-event': events.length === 1 }]}>
      {events.map((event) => (
        <article class="event-card" id={`event-${event.slug}`}>
          {event.photo && (
            <img
              class="event-photo"
              src={event.photo}
              alt={event.photoAlt || ''}
              width="600"
              height="400"
              loading="lazy"
            />
          )}
          <p class="event-date">{dateLabel(event.start)}</p>
          <h3>
            <a href={`/events/${event.slug}/`}>{event.title}</a>
          </h3>
          <p>
            {timeLabel(event.start)} · {event.location || 'Location to be confirmed'}
          </p>
          {event.status !== 'confirmed' && <p class="status-label">{event.status}</p>}
          {event.status === 'confirmed' && !past && Date.now() >= new Date(event.start).getTime() && (
            <p class="event-date">In progress</p>
          )}
          <p>{past ? event.recap || event.description : event.description}</p>
          <a class="text-link" href={`/events/${event.slug}/`}>
            {past ? 'View recap' : 'Event details'} <Icon />
          </a>
        </article>
      ))}
    </div>
  )
) : (
  !past &&
  (compact ? (
    <p class="event-agenda-empty">
      New events will be posted here. Follow MSA on{' '}
      <a href={site.socials[0].url}>Instagram</a> for announcements.
    </p>
  ) : (
    <div class="empty-events">
      <span class="empty-icon">
        <Icon name="calendar" />
      </span>
      <div>
        <h3>Good things are coming.</h3>
        <p>New events will be posted here. Follow MSA on Instagram for announcements.</p>
      </div>
      <a class="button secondary" href={site.socials[0].url}>
        Follow on Instagram <Icon />
      </a>
    </div>
  ))
)}
