---
import Icon from './Icon.astro';
import { site } from '../data/site';
interface Props {
  limit?: number;
  past?: boolean;
  category?: string;
  compact?: boolean;
}
const { limit, past = false, category, compact = false } = Astro.props;
---

<div
  class="event-list"
  data-event-list
  data-mode={compact ? 'compact' : 'full'}
  data-limit={limit ?? ''}
  data-category={category ?? ''}
  data-past={String(past)}
>
  {past && (
    <h2 class="past-events-heading" data-event-list-heading hidden>
      Past gatherings
    </h2>
  )}
  {compact ? (
    <ul class="event-agenda" data-event-list-target aria-busy="true">
      <li class="event-agenda-item is-skeleton" aria-hidden="true" />
      <li class="event-agenda-item is-skeleton" aria-hidden="true" />
    </ul>
  ) : (
    <div class="event-grid" data-event-list-target aria-busy="true">
      <div class="event-card is-skeleton" aria-hidden="true" />
      <div class="event-card is-skeleton" aria-hidden="true" />
      <div class="event-card is-skeleton" aria-hidden="true" />
    </div>
  )}
  {compact ? (
    <p class="event-agenda-empty" data-event-list-empty hidden>
      New events will be posted here. Follow MSA on{' '}
      <a href={site.socials[0].url}>Instagram</a> for announcements.
    </p>
  ) : (
    <div class="empty-events" data-event-list-empty hidden>
      <span class="empty-icon">
        <Icon name="calendar" />
      </span>
      <div>
        <h3>Good things are coming.</h3>
        <p>New events will be posted here. Follow MSA on Instagram for announcements.</p>
      </div>
      <a class="button secondary" href={site.socials[0].url}>
        Follow on Instagram <Icon />
      </a>
    </div>
  )}
  <noscript>
    <p class="event-agenda-empty">
      Enable JavaScript to see current events, or follow MSA on Instagram for announcements.
    </p>
  </noscript>
</div>
<script src="../scripts/events/list.ts"></script>
