---
import { dayKey, type EventRecord } from '../lib/events';

interface Props {
  events: EventRecord[];
}
const { events } = Astro.props;

const now = new Date();
const year = now.getFullYear();
const month = now.getMonth();

const monthLabel = (y: number, m: number) =>
  new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric' }).format(new Date(y, m, 1));

const pad = (n: number) => String(n).padStart(2, '0');
const gridKey = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
const todayKey = gridKey(now);

const buildGrid = (y: number, m: number) => {
  const firstDay = new Date(y, m, 1).getDay();
  const start = new Date(y, m, 1 - firstDay);
  return Array.from({ length: 42 }, (_, i) => {
    const d = new Date(start);
    d.setDate(start.getDate() + i);
    return d;
  });
};

const activeEvents = events.filter((event) => event.status !== 'cancelled');
const eventsByDay = new Map<string, EventRecord[]>();
for (const event of activeEvents) {
  const key = dayKey(event.start);
  const list = eventsByDay.get(key) ?? [];
  list.push(event);
  eventsByDay.set(key, list);
}

const days = buildGrid(year, month);
const weekdays = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
---

<section class="calendar" data-calendar aria-label="Events calendar">
  <div class="calendar-head">
    <h3 data-calendar-label>{monthLabel(year, month)}</h3>
    <div class="calendar-nav">
      <button type="button" class="icon-button" data-calendar-prev aria-label="Previous month" hidden>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 6l-6 6 6 6" />
        </svg>
      </button>
      <button type="button" class="icon-button" data-calendar-next aria-label="Next month" hidden>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 6l6 6-6 6" />
        </svg>
      </button>
    </div>
  </div>
  <div class="calendar-weekdays">
    {weekdays.map((day) => <span class="calendar-weekday">{day}</span>)}
  </div>
  <div class="calendar-grid" data-calendar-grid>
    {days.map((d) => {
      const key = gridKey(d);
      const dayEvents = eventsByDay.get(key) ?? [];
      const outside = d.getMonth() !== month;
      const isToday = key === todayKey;
      return (
        <div
          class:list={[
            'calendar-day',
            { 'is-outside': outside, 'is-today': isToday, 'has-events': dayEvents.length > 0 },
          ]}
        >
          <span class="calendar-day-number">{d.getDate()}</span>
          {dayEvents.length > 0 && <span class="calendar-dot" aria-hidden="true" />}
        </div>
      );
    })}
  </div>
  <script
    is:inline
    type="application/json"
    data-calendar-events
    set:html={JSON.stringify(activeEvents)}
  />
</section>
