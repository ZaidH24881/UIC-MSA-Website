---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import EventList from '../components/EventList.astro';
import PrayerSummary from '../components/PrayerSummary.astro';
import ResourceGrid from '../components/ResourceGrid.astro';
import { site } from '../data/site';
import notices from '../data/announcements.json';
import { activeNotices } from '../lib/events';
import CommunityDeck from '../components/CommunityDeck.astro';
import CommunityMarquee from '../components/CommunityMarquee.astro';
---

<Layout
  title="Find your community"
  description="Find your community at UIC. Join the Muslim Students Association for prayer, friendship, learning, events, and campus resources."
>
  {activeNotices(notices).map((notice) => (
    <aside class="notice">
      <div class="container">
        <a href={notice.url}>{notice.summary}</a>
      </div>
    </aside>
  ))}
  <section class="container hero cinema-hero" data-motion-home>
    <div class="hero-copy">
      <p class="eyebrow" data-hero-enter>
        Muslim Students Association at UIC
      </p>
      <h1>
        <span class="hero-line">
          <span data-hero-enter>Your people.</span>
        </span>
        <span class="hero-line">
          <span data-hero-enter>Your place.</span>
        </span>
      </h1>
      <p class="hero-intro" data-hero-enter>
        Rooted in faith. Connected for life.
        <br />
        Find your community at UIC.
      </p>
      <div class="actions" data-hero-enter>
        <span class="magnetic-wrap" data-magnetic>
          <a class="button" href="/join/">
            Join MSA <Icon />
          </a>
        </span>
        <a class="button secondary" href="/events/">
          Explore events
        </a>
      </div>
    </div>
    <div class="cinema-stage" data-hero-stage>
      {/* Separate wrappers keep entrance and scroll transforms independent. */}
      <div data-hero-enter>
        <div class="cinema-frame" data-cinema>
          <Photo
            name="campus-community"
            alt="Students gathered for prayer with the Chicago skyline behind them"
            eager
            class="hero-photo"
          />
          <div class="cinema-caption">
            <span>Faith. Friendship. Chicago.</span>
            <a href="/community/">
              Meet our community <Icon />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="belonging section container" aria-labelledby="belonging-title">
    <p class="eyebrow">More than a student organization</p>
    <h2 id="belonging-title">
      A big campus.
      <br />A closer community.
    </h2>
    <p class="belonging-copy">
      Between the lectures and the late nights, find people who make UIC feel like home. A shared
      meal. A moment of prayer. A friendship that stays with you.
    </p>
    <div class="belonging-links">
      <a href="/about/">
        Get to know MSA <Icon />
      </a>
      <span>
        Your first semester or your final year.
        <br />
        There’s a place for you here.
      </span>
    </div>
  </section>
  <section class="section upcoming-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Make time for community</p>
          <h2>What’s happening at MSA</h2>
        </div>
        <a class="text-link" href="/events/">
          View all events <Icon />
        </a>
      </div>
      <EventList limit={3} />
    </div>
  </section>
  <PrayerSummary />
  <section class="section container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Life, together</p>
        <h2>The moments that make MSA.</h2>
      </div>
      <a class="text-link" href="/community/">
        See our community <Icon />
      </a>
    </div>
    <p class="section-intro">
      Time to pause, people to meet, and a community to come back to. This is what belonging can
      look like.
    </p>
    <CommunityDeck />
    <div class="community-note">
      <p>
        Connected on campus.
        <br />
        Connected beyond it.
      </p>
      <a href={site.socials[0].url}>
        <strong>{site.instagramFollowers}</strong> followers on Instagram <Icon />
      </a>
    </div>
  </section>
  <section class="first-step section" data-join-scrubber>
    <div class="container split">
      <div>
        <p class="eyebrow">New here? Assalamu alaikum.</p>
        <h2>
          Your first step
          <br />
          starts here.
        </h2>
        <p class="prose">
          You don’t have to know anyone to belong. Come as you are, find your people, and make your
          own place in MSA.
        </p>
        <a class="button" href="/join/">
          How to join <Icon />
        </a>
      </div>
      <div class="join-journey">
        <div class="join-scrub-controls" hidden>
          <div class="join-scrub-heading">
            <label for="join-progress">How to join</label>
            <span aria-hidden="true">
              Step <strong data-step-number>1</strong> of 3
            </span>
          </div>
          <input
            id="join-progress"
            type="range"
            min="0"
            max="1"
            step="0.01"
            value="0"
            aria-valuetext="Step 1: Become a member."
          />
          <div class="join-track" aria-hidden="true">
            <span data-join-fill></span>
          </div>
        </div>
        <ol class="steps" data-join-steps>
          <li>
            <span>1</span>
            <div>
              <h3>Become a member.</h3>
              <p>Register through UIC CampusGroups.</p>
            </div>
          </li>
          <li>
            <span>2</span>
            <div>
              <h3>Connect with the community.</h3>
              <p>Complete the group-access form and follow our announcements.</p>
            </div>
          </li>
          <li>
            <span>3</span>
            <div>
              <h3>Come to an event.</h3>
              <p>Find a gathering that interests you. Bring a friend, or meet one here.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>
  <section class="section container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">A little help along the way</p>
        <h2>Campus life, made easier.</h2>
      </div>
      <a class="text-link" href="/resources/">
        All resources <Icon />
      </a>
    </div>
    <ResourceGrid featured />
  </section>
  <CommunityMarquee />
  <section class="support-band">
    <div class="container">
      <div>
        <h2>
          Help make these
          <br />
          <span class="serif">moments possible.</span>
        </h2>
        <p>Your support helps bring our community together through MSA programs and gatherings.</p>
      </div>
      <a class="button light" href="/donate/">
        Support MSA <Icon />
      </a>
    </div>
  </section>
</Layout>
