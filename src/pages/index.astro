---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import EventList from '../components/EventList.astro';
import QuickLinks from '../components/QuickLinks.astro';
import notices from '../data/announcements.json';
import { activeNotices } from '../lib/events';
---

<Layout
  title="Find your community"
  description="Find your community at UIC. Join the Muslim Student Association for prayer, friendship, learning, events, and campus resources."
>
  {activeNotices(notices).map((notice) => (
    <aside class="notice">
      <div class="container">
        <a href={notice.url}>{notice.summary}</a>
      </div>
    </aside>
  ))}
  <section class="container hero cinema-hero" data-motion-home>
    <div class="hero-copy">
      <p class="eyebrow" data-hero-enter>
        Muslim Student Association at UIC
      </p>
      <h1>
        <span class="hero-line">
          <span data-hero-enter>Your people.</span>
        </span>
        <span class="hero-line">
          <span data-hero-enter>Your place.</span>
        </span>
      </h1>
      <p class="hero-intro" data-hero-enter>
        Rooted in faith. Connected for life.
        <br />
        Find your community at UIC.
      </p>
      <div class="actions" data-hero-enter>
        <span class="magnetic-wrap" data-magnetic>
          <a class="button" href="/join/">
            Join MSA <Icon />
          </a>
        </span>
        <a class="button secondary" href="/events/">
          Explore events
        </a>
      </div>
    </div>
    <div class="cinema-stage">
      <div data-hero-enter>
        <div class="cinema-frame">
          <Photo
            name="brothers-group"
            alt="MSA brothers smiling together at a gathering"
            eager
            class="hero-photo"
          />
          <div class="cinema-caption">
            <span>Friends. Family. Faith.</span>
            <a href="/community/">
              Meet our community <Icon />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="section container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Find your way around</p>
        <h2>Everything MSA, in one place.</h2>
      </div>
    </div>
    <div class="content-grid">
      <QuickLinks />
      <aside class="aside-panel">
        <h3>Upcoming</h3>
        <EventList compact limit={3} />
        <a class="text-link" href="/events/" style="margin-top:16px">
          View all events <Icon />
        </a>
      </aside>
    </div>
  </section>
  <section class="support-band">
    <div class="container">
      <div>
        <h2>
          Help make these
          <br />
          <span class="serif">moments possible.</span>
        </h2>
        <p>Your support helps bring our community together through MSA programs and gatherings.</p>
      </div>
      <a class="button light" href="/donate/">
        Support MSA <Icon />
      </a>
    </div>
  </section>
</Layout>
