---
import Layout from '../layouts/Layout.astro';
import PageLead from '../components/PageLead.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---

<Layout
  title="Join MSA"
  description="Join MSA at UIC: register on CampusGroups, complete the group-access form, and connect with the WhatsApp community."
>
  <PageLead
    title="You belong here."
    eyebrow="Join MSA"
    intro="New to campus, new to MSA, or ready to reconnect? Take your first step into the community."
  />
  <div class="container page-content">
    <div class="content-grid">
      <div class="join-steps">
        <ol class="steps">
          <li>
            <span>1</span>
            <div>
              <h2>Register as an MSA member.</h2>
              <p>
                Start with the official membership registration on UIC CampusGroups. Sign in with
                your UIC account and complete the registration.
              </p>
              <a class="button" href={site.memberUrl}>
                Register on CampusGroups <Icon />
              </a>
            </div>
          </li>
          <li>
            <span>2</span>
            <div>
              <h2>Complete the group-access form.</h2>
              <p>
                After registering, submit the form to request access to the brothers’ or sisters’
                WhatsApp group. These groups are for currently enrolled UIC students who are
                registered MSA members.
              </p>
              <a class="button secondary" href={site.groupFormUrl}>
                Open the group-access form <Icon />
              </a>
              <p class="fine-print">
                Submitting the form requests access; it does not add you automatically.
              </p>
            </div>
          </li>
          <li>
            <span>3</span>
            <div>
              <h2>Connect and come along.</h2>
              <p>
                Join the MSA WhatsApp Community for announcements, invite your friends, and keep an
                eye out for your next gathering.
              </p>
              <div class="actions">
                <a class="button" href={site.whatsappUrl}>
                  Join the WhatsApp Community
                </a>
                <a class="text-link" href="/events/">
                  Explore events <Icon />
                </a>
              </div>
            </div>
          </li>
        </ol>
      </div>
      <aside>
        <Photo
          name="community-together"
          alt="Three people smiling together at a table during an MSA gathering"
          caption="Together at an MSA gathering. Photo: Art of Khanan."
        />
        <div class="aside-panel" style="margin-top:28px">
          <h2>A familiar face starts with hello.</h2>
          <p>Questions about joining or getting into a group? The MSA team can help.</p>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </aside>
    </div>
    <section class="faq">
      <h2>A few things to know</h2>
      <details>
        <summary>Who can request the brothers’ or sisters’ group?</summary>
        <p>
          Currently enrolled UIC students who have registered as MSA members can submit the
          CampusGroups form to request access.
        </p>
      </details>
      <details>
        <summary>Do I have to be Muslim to connect with MSA?</summary>
        <p>
          MSA welcomes people of all faiths and levels of practice. You’re welcome to learn about
          our community and attend open activities.
        </p>
      </details>
      <details>
        <summary>I’m an alumnus. How can I stay connected?</summary>
        <p>
          Follow our social channels and connect with the{' '}
          <a href={site.socials[5].url}>MSA LinkedIn group</a>. For alumni-specific opportunities,{' '}
          <a href={`mailto:${site.email}?subject=Alumni%20connection`}>email the team</a>.
        </p>
      </details>
      <details>
        <summary>What if I can’t access a registration link?</summary>
        <p>
          Make sure you are signed in to your UIC CampusGroups account. If the problem continues,{' '}
          <a href={`mailto:${site.email}?subject=Help%20joining%20MSA`}>ask MSA for help</a>.
        </p>
      </details>
    </section>
  </div>
</Layout>
