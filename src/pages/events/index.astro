---
import Layout from '../../layouts/Layout.astro';
import PageLead from '../../components/PageLead.astro';
import EventList from '../../components/EventList.astro';
import EventCalendar from '../../components/EventCalendar.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
import eventData from '../../data/events.json';
import type { EventRecord } from '../../lib/events';
---

<Layout
  title="Events"
  description="Find MSA at UIC events, Friday prayer updates, community announcements, and opportunities to connect."
>
  <PageLead
    title="A reason to come together."
    eyebrow="Events"
    intro="Conversations, learning, and time with your community. Find your next MSA gathering here."
  />
  <div class="container page-content">
    <section>
      <h2>Current and upcoming events</h2>
      <div class="events-layout">
        <EventCalendar events={eventData.events as EventRecord[]} />
        <aside class="aside-panel events-agenda-panel">
          <div class="agenda-selected" data-agenda-selected hidden>
            <div class="agenda-selected-head">
              <h3 data-agenda-selected-title></h3>
              <button type="button" data-agenda-clear>Show all upcoming</button>
            </div>
            <ul class="event-agenda" data-agenda-selected-list></ul>
            <p class="event-agenda-empty" data-agenda-selected-empty hidden>
              No events on this date.
            </p>
          </div>
          <div data-agenda-default>
            <h3>Upcoming</h3>
            <EventList compact />
          </div>
        </aside>
      </div>
    </section>
    <div class="content-grid" style="margin-top:48px">
      <div>
        <h2>Stay in the loop.</h2>
        <p>
          Confirmed dates, locations, and registration details will appear here as they are
          announced. For the latest updates, follow MSA on Instagram or join the WhatsApp Community.
        </p>
        <div class="actions">
          <a class="button" href={site.whatsappUrl}>
            Join community announcements
          </a>
          <a class="text-link" href={site.linksUrl}>
            MSA’s current links <Icon />
          </a>
        </div>
      </div>
      <aside class="aside-panel">
        <h2>See you on Friday.</h2>
        <p>
          Jumu’ah is part of the rhythm of our campus community. Check the prayer page and weekly
          announcement for the schedule and location.
        </p>
        <a class="text-link" href="/prayer/">
          Prayer &amp; Jumu’ah <Icon />
        </a>
      </aside>
    </div>
    <EventList past />
  </div>
</Layout>
