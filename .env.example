# Set to the chosen production origin when hosting is configured.
# Example after the authorized domain cutover: https://msaatuic.org
SITE_URL=

# Firebase web app config (Firebase Console -> Project settings -> Your apps).
# These are safe to be public; Firestore security rules are what actually
# protect reads/writes, not secrecy of these values. See docs/board-events-setup.md.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
